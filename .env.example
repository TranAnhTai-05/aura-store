# Copy this file to .env and fill in the values. .env is never committed.

# --- API server ---
API_PORT=4000
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Only for production builds served over plain http (not recommended): COOKIE_SECURE=false

# --- MySQL ---
# With XAMPP / MySQL Installer the usual values are port 3306, user root, empty password.
# With the bundled docker-compose.yml keep port 3307 and pick your own passwords.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=aura
DB_PASSWORD=change-me
DB_NAME=aura_store
# Only used by docker-compose.yml to create the container
DB_ROOT_PASSWORD=change-me
