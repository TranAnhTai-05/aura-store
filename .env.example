# Copy this file to .env and fill in the values. .env is never committed.

# --- API server ---
API_PORT=4000
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Only for production builds served over plain http (not recommended): COOKIE_SECURE=false

# --- Microsoft SQL Server ---
# Create the database in GearHost or SQL Server Management Studio before starting the app.
DB_HOST=127.0.0.1
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=change-me-Use-A-Strong-Password1!
DB_NAME=aura_store
# Encryption is enabled by default. Set trust to true only if the provider uses a
# certificate that cannot be validated by Node.js.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
