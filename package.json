{
  "name": "aura-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node node_modules/vite/bin/vite.js --port=3000 --host=0.0.0.0",
    "dev:api": "node node_modules/tsx/dist/cli.mjs watch server/index.ts",
    "build": "node node_modules/vite/bin/vite.js build",
    "start": "node node_modules/tsx/dist/cli.mjs server/index.ts",
    "db:seed": "node node_modules/tsx/dist/cli.mjs scripts/db.ts seed",
    "db:upgrade": "node node_modules/tsx/dist/cli.mjs scripts/db.ts upgrade",
    "db:reset": "node node_modules/tsx/dist/cli.mjs scripts/db.ts reset",
    "lint": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
